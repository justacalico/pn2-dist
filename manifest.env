# Input package pins. Each entry is a generic package in this project's
# registry; upload-inputs.sh publishes a new version, the pin picks it up.
PIN_GSI=1
PIN_STACK=1
PIN_APPS=1
PIN_APPLIBS=1
PIN_OEM=1
PIN_LOADINGRES=1
PIN_BLOBS=2
PIN_SEETHROUGH=1

# Source repo refs, cloned from gitlab.com/neosalsa at build time.
TOOLS_REF=real-platform-key
OVERLAY_REF=main
SHIM_REF=main
VRHOME_REF=main
PN2XR_REF=main
LIBRARY_REF=main
QUICKPANEL_REF=main

# Flutter toolchain pin - builds applications/library + applications/quick-panel
FLUTTER_VERSION=3.44.6
